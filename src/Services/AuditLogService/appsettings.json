{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Information",
            "Microsoft.AspNetCore.Routing": "Warning",
            "Microsoft.AspNetCore.Mvc.Infrastructure": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.AspNetCore.Mvc.StatusCodeResult": "Warning"
        },
        "Console": {
            "FormatterName": "simple",
            "FormatterOptions": {
                "SingleLine": true,
                "IncludeScopes": true
            }
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Default": "",
        "BotToken": ""
    },
    "Archivation": {
        "DefaultRetentionMonths": 12,
        "RetentionMonths": {
            "GatewayReconnect": 6,
            "UserLeftBan": 60,
            "ApiNonV2": 6,
            "ChannelAndRoleChanges": 24,
            "OverwritesAndIdentity": 36,
            "Unban": 60
        },
        "MinimalItemsToArchive": 1,
        "MaxItemsToArchivePerRun": 2500,
        "ReadPageSize": 100,
        "CompressedSizeWarningThreshold": 10485760
    },
    "AsyncMessaging": {
        "QueueName": "audit_log_service",
        "ListenerCount": 1,
        "MaximumParallelMessages": 1,
        "DefaultExecutionTimeout": "04:00:00",
        "DeadLetterQueueExpiration": "14.00:00:00",
        "RetryCooldowns": [ "00:00:01", "00:00:05", "00:00:30" ],
        "PurgeOnStartup": false
    },
    "RabbitMQ": {
        "Hostname": "",
        "Username": "",
        "Password": ""
    }
}
