# Copy to compose/.env (git-ignored) and fill in. compose/infrastructure.yml,
# compose/database.yml and compose/grillbot.yml all read it. Every variable has a
# default in the compose files, so anything you leave out falls back to a default.

# --- Infrastructure (local containers only, never reused anywhere else) --------
RABBITMQ_USERNAME=grillbot
RABBITMQ_PASSWORD=grillbot
# Shared by redis-main and redis-ephemeral.
REDIS_PASSWORD=grillbot

# --- PostgreSQL ---------------------------------------------------------------
# One database per service (AuditLogService, PointsService, ...).
#
# Default: the local container from compose/database.yml, reached by the service
# containers as "postgres". Its init script creates DB_USERNAME / DB_PASSWORD and
# all the databases on first start. From the IDE use localhost:DB_PUBLISHED_PORT.
#
# Own PostgreSQL instead? Skip compose/database.yml and set DB_HOST to your server
# (host.docker.internal for one running on this machine), with an existing role
# that owns the databases. The password must not contain ';'.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=grillbot
DB_PASSWORD=grillbot
# compose/database.yml only: superuser password and the port published on the host.
DB_SUPERUSER_PASSWORD=postgres
DB_PUBLISHED_PORT=5432

# --- Discord ------------------------------------------------------------------
# Optional. Empty turns off the Discord client of the services that have one.
DISCORD_BOT_TOKEN=

# --- Rubbergod ------------------------------------------------------------------
RUBBERGOD_CHANNEL_ID=942801245486321705

# --- Service-to-service URLs ----------------------------------------------------
# Defaults address the containers. When the target runs in your IDE instead,
# point the caller at the host, e.g. http://host.docker.internal:5134/
GRAPHICS_API=http://graphics:3000/
USER_MEASURES_API=http://user_measures_service:5134/
UNVERIFY_API=http://unverify_service:5037/
